# Only application sources, tests, licenses, and project configuration belong here.
/*
!/.gitignore
!/README.md
!/ENVIRONMENT_ROADMAP.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/src/
!/tests/
!/public/

# Secrets and local configuration (also excluded inside allowed directories).
.env
.env.*
private/
secrets/
credentials/
.aws/
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc
affiliate-config.json
affiliate-links.html
dmm-affiliate-link.txt
dmm-api-config.json
*.sql
*_backup*

# Dependencies, generated output, browser profiles, and local work.
node_modules/
dist/
build/
coverage/
.cache/
.vite/
work/
profile/
cache/
test-results/
playwright-report/
*.log
*.tsbuildinfo

# Persisted/exported city data and local databases; tests generate fixtures in code.
saves/
save-data/
saved-cities/
exports/
demo/
*.city
*.citygenesis
*.db
*.db-*
*.sqlite*
/src/**/*.json
/tests/**/*.json
/public/**/*.json
